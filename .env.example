# "demo" needs no credentials (default). "supabase" is used after Phase 9.
DATA_MODE=demo

# Supabase (leave commented until Phase 9). Only the SERVER uses these.
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
